@model List<TrabajoPracticoDatos.Models.Producto>
@using System.Globalization

@{
    ViewData["Title"] = "Productos";
    CultureInfo argentina = new CultureInfo("es-AR");
}

<div class="titulo-pagina">
    <div>
        <span class="etiqueta">Administración</span>
        <h1>Productos</h1>
    </div>
    <a asp-action="Create" class="btn-tienda">Nuevo producto</a>
</div>

<div class="tabla-contenedor">
    <table class="tabla-admin">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr class="@(producto.Activo ? "" : "fila-inactiva")">
                    <td>
                        @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                        {
                            <img src="@producto.ImagenUrl" alt="@producto.Nombre" class="miniatura" />
                        }
                        else
                        {
                            <div class="miniatura miniatura-vacia">Sin foto</div>
                        }
                    </td>
                    <td>@producto.Nombre</td>
                    <td>@producto.Categoria?.Nombre</td>
                    <td>@producto.Precio.ToString("C0", argentina)</td>
                    <td>@producto.Stock</td>
                    <td>
                        @if (producto.Activo)
                        {
                            <span class="estado estado-activa">Activo</span>
                        }
                        else
                        {
                            <span class="estado estado-inactiva">Inactivo</span>
                        }
                    </td>
                    <td>
                        <div class="acciones">
                            <a asp-action="Edit" asp-route-id="@producto.Id" class="btn-contorno">Editar</a>

                            @if (producto.Activo)
                            {
                                <form asp-action="Delete" asp-route-id="@producto.Id" method="post"
                                      onsubmit="return confirm('¿Seguro que querés dar de baja este producto?');">
                                    <button type="submit" class="btn-contorno peligro">Eliminar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Reactivar" asp-route-id="@producto.Id" method="post">
                                    <button type="submit" class="btn-contorno exito">Reactivar</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
