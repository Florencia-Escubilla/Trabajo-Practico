@model TrabajoPracticoDatos.Models.Producto

@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="titulo-pagina">
    <div>
        <span class="etiqueta">Administración</span>
        <h1>Nuevo producto</h1>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="formulario">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-4">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="(SelectList)ViewBag.Categorias" class="form-control">
            <option value="">Elegí una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-4">
            <label asp-for="Precio" class="form-label"></label>
            <input asp-for="Precio" type="number" step="0.01" min="1" class="form-control" />
            <span asp-validation-for="Precio" class="text-danger"></span>
        </div>
        <div class="col-sm-6 mb-4">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" min="0" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-4">
            <label asp-for="Talle" class="form-label"></label>
            <input asp-for="Talle" class="form-control" />
            <span asp-validation-for="Talle" class="text-danger"></span>
        </div>
        <div class="col-sm-6 mb-4">
            <label asp-for="Color" class="form-label"></label>
            <input asp-for="Color" class="form-control" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-4">
        <label for="imagen" class="form-label">Foto</label>
        <input type="file" name="imagen" id="imagen" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <small class="text-muted">JPG, PNG o WEBP, hasta 5 MB.</small>
        <img id="vistaPrevia" class="vista-previa" alt="Vista previa de la imagen" hidden />
    </div>

    <div class="botones">
        <button type="submit" class="btn-tienda">Guardar</button>
        <a asp-action="Index" class="btn-tienda claro" style="border-color: var(--negro);">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imagen').addEventListener('change', function () {
            const archivo = this.files[0];
            const vistaPrevia = document.getElementById('vistaPrevia');

            if (archivo) {
                vistaPrevia.src = URL.createObjectURL(archivo);
                vistaPrevia.hidden = false;
            }
        });
    </script>
}
