@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="caja-centrada">
    <span class="etiqueta">Error</span>
    <h1>Algo salió mal</h1>
    <p>Ocurrió un error al procesar tu pedido. Probá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p><small>Código del error: <code>@Model.RequestId</code></small></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-tienda">Volver al inicio</a>
</div>
