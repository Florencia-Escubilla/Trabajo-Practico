@model Trabajo_Practico.Models.Categoria

@{
    ViewData["Title"] = "Editar categoría";
}

<div class="titulo-pagina">
    <div>
        <span class="etiqueta">Administración</span>
        <h1>Editar categoría</h1>
    </div>
</div>

<form asp-action="Edit" method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-4">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Activa" class="form-check-input" />
        <label asp-for="Activa" class="form-check-label"></label>
    </div>

    <div class="botones">
        <button type="submit" class="btn-tienda">Guardar cambios</button>
        <a asp-action="Index" class="btn-tienda claro" style="border-color: var(--negro);">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}