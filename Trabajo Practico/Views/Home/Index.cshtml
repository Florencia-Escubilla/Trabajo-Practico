@inject TrabajoPracticoDatos.Interfaces.ICompraRepository CompraRepository
@{
    ViewData["Title"] = "Inicio";
    ViewData["AnchoCompleto"] = true;
    int ventasNuevas = User.IsInRole("Administrador") ? CompraRepository.ContarNoVistas() : 0;
}

@if (ventasNuevas > 0)
{
    <div class="container py-4">
        <div class="mensaje mensaje-exito aviso-ventas">
            <span>@(ventasNuevas == 1 ? "Tenés 1 venta nueva." : $"Tenés {ventasNuevas} ventas nuevas.")</span>
            <a asp-controller="Compras" asp-action="Ventas" class="btn-contorno">Ver ventas</a>
        </div>
    </div>
}

<section class="hero">
    <div class="container hero-texto">
        <span class="etiqueta">Nueva temporada</span>
        <h1>Vestite<br />a tu manera</h1>
        <a asp-controller="Catalogo" asp-action="Index" class="btn-tienda claro">Ver colección</a>
    </div>
</section>

<section class="beneficios">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4">
                <h6>Envío gratis</h6>
                <p>En compras superiores a $80.000</p>
            </div>
            <div class="col-md-4">
                <h6>Cambios sin cargo</h6>
                <p>Tenés 30 días para cambiar tu prenda</p>
            </div>
            <div class="col-md-4">
                <h6>3 cuotas sin interés</h6>
                <p>Con todas las tarjetas</p>
            </div>
        </div>
    </div>
</section>

<section class="temporada">
    <h2>Básicos que duran</h2>
    <p>Prendas de algodón, cortes cómodos y colores que combinan con todo.</p>
    <a asp-controller="Catalogo" asp-action="Index" class="btn-tienda">Explorar</a>
</section>